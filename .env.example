# Telegram Bot Token（从 @BotFather 获取）
BOT_TOKEN=

# 收款/能量闪租地址（TDxxxxxxxx，点击后会自动复制）
ENERGY_ADDRESS=TDxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 每天每人送5次能量 —— 小程序(Mini App)地址，必须是 https 开头
# 本项目已内置 Mini App 页面，部署到 Railway 后填：https://你的Railway域名/webapp/
WEBAPP_URL=https://your-railway-domain.up.railway.app/webapp/

# 在线客服跳转的 Telegram 用户名/群组，不带 @，例如 my_support
SUPPORT_USERNAME=your_support_username

# 闪租价格文案（可直接改文字，不涉及链上逻辑）
PRICE_WITH_USDT=1.5
PRICE_WITHOUT_USDT=3
FEE_SAVE_PERCENT=80

# U 换 TRX 参考汇率文案（仅展示，不做实际兑换逻辑）
EXCHANGE_RATE_NOTE=U换TRX比例请以客服实时汇率为准

# Railway 会自动注入 PORT，本地调试可自定义
PORT=3000

# ===== 每天每人送5次能量 —— 免费领取相关配置 =====

# 每人每天可免费领取的次数
FREE_ENERGY_DAILY_LIMIT=5

# 目标地址有 USDT 时赠送的能量数量
FREE_ENERGY_COUNT_WITH_USDT=65000
# 目标地址无 USDT 时赠送的能量数量（无U需要额外的转账手续费能量，数值更高）
FREE_ENERGY_COUNT_WITHOUT_USDT=130000

# TronGrid 查询接口（用于判断目标地址是否持有 USDT），不填 API Key 也可用但有更严格的限速
TRONGRID_BASE_URL=https://api.trongrid.io
TRONGRID_API_KEY=

# 第三方能量闪充服务的鉴权信息（HMAC-SHA256 签名认证）
ENERGY_PROVIDER_API_URL=https://your-energy-provider.example.com/api/energy
ENERGY_PROVIDER_API_KEY=
ENERGY_PROVIDER_API_SECRET=
